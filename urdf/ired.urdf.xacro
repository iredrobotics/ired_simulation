<?xml version="1.0" ?>
<robot name="ired" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="lidar_noise_stddev" default="0.01" />

  <xacro:include filename="$(find ired_simulation)/urdf/materials.xacro" />
  <xacro:include filename="$(find ired_simulation)/urdf/ired.gazebo" />

  <link name="base_footprint"/>
  <link name="imu_link"/>

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00568" ixy="0.0" ixz="0.0" iyy="0.00683" iyz="0.0" izz="0.01012"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 1.57079632679 3.14159265359" xyz="0.035 0.04 0"/>
      <geometry>
        <mesh filename="file://$(find ired_simulation)/meshes/ired.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.019"/>
      <geometry>
        <box size="0.260 0.232 0.11966"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_right_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.41e-05" ixy="0.0" ixz="0.0" iyy="3.41e-05" iyz="0.0" izz="5.78e-05"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
  </link>
  <link name="wheel_left_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.41e-05" ixy="0.0" ixz="0.0" iyy="3.41e-05" iyz="0.0" izz="5.78e-05"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.114"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.035"/>
      </geometry>
    </collision>
  </link>

  <link name="base_camera">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000011" ixy="0.0" ixz="0.0" iyy="0.000107" iyz="0.0" izz="0.000102"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.01"/>
      <geometry>
        <box size="0.109 0.019 0.031"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.079"/>
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 -0.106 -0.047"/>
  </joint>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 0.106 -0.047"/>
  </joint>
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin rpy="0.0 0.0 3.14159265359" xyz="0.087 0.0 0.046"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.075 -0.05 0.016"/>
  </joint>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_camera"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.15 0.0 -0.009"/>
  </joint>

</robot>
